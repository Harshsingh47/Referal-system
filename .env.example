# ==========================================
# Referral Registration & QR Code System
# Environment Configuration Template
# ==========================================

# Backend Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/referral_system?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/referral_system?retryWrites=true&w=majority

# Frontend URL (Used for generating referral links and QR code payloads)
FRONTEND_URL=http://localhost:5173

# AES-256 Encryption Secret Key (32 bytes / 64 hex characters)
# For production, generate a secure random 32-byte key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=c4a8b79e13d96e57209930f342f0e0811e5f381ad7940251783457a44f22031a
